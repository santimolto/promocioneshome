<?php
/**
 * Bloque Promociones del home.
 *
 * Este archivo es un ejemplo preparado para copiarse en:
 *
 * app/design/frontend/Mb/Hyva2/Magento_Theme/templates/home/promociones.phtml
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

$vm = $viewModels->require(\Santi\PromocionesHome\ViewModel\Promociones::class);
$banner = $vm->getBanner();

if (!$banner) {
    // Fallback por si el bloque no está habilitado o no hay media configurado.
    $banner = [
        'is_video'      => false,
        'image_url'     => $block->getViewFileUrl('images/home/promociones.webp'),
        'image_mobile_url' => '',
        'image_alt'     => __('Banner Promociones'),
        'title'         => __('Promociones'),
        'subtitle'      => '',
        'button_text'   => __('Ver promociones'),
        'button_url'    => $block->getUrl('promociones.html'),
        'color_primary' => '#8cc4b2',
        'poster_url'    => '',
    ];
}

$title = $banner['title'] ?? '';
$subtitle = $banner['subtitle'] ?? '';
$btnText = $banner['button_text'] ?? '';
$btnUrl = $banner['button_url'] ?? '#';
$color = $banner['color_primary'] ?? '#8cc4b2';
$isVideo = !empty($banner['is_video']);
$imageUrl = $banner['image_url'] ?? '';
$imageAlt = $banner['image_alt'] ?? ($title ?: 'Promociones');
$videoUrl = $banner['video_url'] ?? '';
$posterUrl = $banner['poster_url'] ?? $imageUrl;
$imageMobileUrl = $banner['image_mobile_url'] ?? '';
$posterMobileUrl = $banner['poster_mobile_url'] ?? '';

// Punto de corte móvil/escritorio (equivale a "md" de Tailwind: < 768px es móvil).
$mobileMedia = '(max-width: 767px)';
?>

<section class="relative w-full overflow-hidden my-10" style="min-height: 250px;">
    <?php if ($isVideo && $videoUrl): ?>
        <?php if ($posterMobileUrl): ?>
            <?php // Poster responsive: el atributo poster de <video> no admite versión móvil,
                  // así que se pinta un <picture> debajo y el vídeo (transparente hasta cargar) encima. ?>
            <picture>
                <source media="<?= $escaper->escapeHtmlAttr($mobileMedia) ?>"
                        srcset="<?= $escaper->escapeUrl($posterMobileUrl) ?>">
                <img class="absolute inset-0 w-full h-full object-cover"
                     src="<?= $escaper->escapeUrl($posterUrl ?: $posterMobileUrl) ?>"
                     alt=""
                     aria-hidden="true"
                     width="1920"
                     height="1080" />
            </picture>
        <?php endif; ?>
        <video class="absolute inset-0 w-full h-full object-cover"
               autoplay loop muted playsinline
               <?php if ($posterUrl && !$posterMobileUrl): ?>poster="<?= $escaper->escapeUrl($posterUrl) ?>"<?php endif; ?>>
            <source src="<?= $escaper->escapeUrl($videoUrl) ?>" type="video/mp4">
        </video>
    <?php else: ?>
        <picture>
            <?php if ($imageMobileUrl): ?>
                <source media="<?= $escaper->escapeHtmlAttr($mobileMedia) ?>"
                        srcset="<?= $escaper->escapeUrl($imageMobileUrl) ?>">
            <?php endif; ?>
            <img class="absolute inset-0 w-full h-full object-cover"
                 src="<?= $escaper->escapeUrl($imageUrl) ?>"
                 alt="<?= $escaper->escapeHtmlAttr($imageAlt) ?>"
                 loading="lazy"
                 width="1920"
                 height="1080" />
        </picture>
    <?php endif; ?>

    <div class="relative z-10 flex items-center justify-center h-full w-full py-16 px-4 md:py-24 lg:py-32 bg-black bg-opacity-40">
        <div class="text-center text-white">
            <?php if ($title): ?>
                <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-4 drop-shadow-lg">
                    <?= $escaper->escapeHtml($title) ?>
                </h2>
            <?php endif; ?>

            <?php if ($subtitle): ?>
                <p class="text-lg md:text-2xl mb-6 drop-shadow">
                    <?= $escaper->escapeHtml($subtitle) ?>
                </p>
            <?php endif; ?>

            <?php if ($btnText && $btnUrl): ?>
                <a href="<?= $escaper->escapeUrl($btnUrl) ?>"
                   class="inline-block px-8 py-3 rounded-full font-semibold text-lg transition-all duration-300 ease-in-out hover:scale-105 hover:shadow-lg"
                   style="background-color: <?= $escaper->escapeHtmlAttr($color) ?>; color: #fff;">
                    <?= $escaper->escapeHtml($btnText) ?>
                </a>
            <?php endif; ?>
        </div>
    </div>
</section>
